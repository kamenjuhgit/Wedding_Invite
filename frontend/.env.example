# Empty locally: Vite proxies public /api routes to Flask port 5000.
VITE_API_URL=
# Production: set to your purchased domain after HTTPS is working.
# VITE_SITE_URL=https://selamandkamenju.com
VITE_SITE_URL=
# Empty recommended locally: /api/admin is proxied to private Flask on port 5001.
# If keeping an old override, use localhost consistently (not a mix of localhost/127.0.0.1).
VITE_ADMIN_API_URL=
# DEV_ADMIN_API_TARGET=http://127.0.0.1:5001
# Optional, restricted browser key and cloud-styled Google Maps Map ID.
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=
