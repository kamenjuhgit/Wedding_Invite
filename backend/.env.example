# setup.py generates a private random JWT/HMAC secret; preserve your existing secret on upgrade.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# Both Flask services MUST use the same persistent database file.
# DATABASE_PATH=/srv/wedding/data/wedding.sqlite3
# True when the admin browser connection uses HTTPS; local HTTP/SSH-tunnel development uses false.
COOKIE_SECURE=false

# Transactional email: fill these with your provider's SMTP credentials.
# The domain must be purchased and verified before live delivery works.
MAIL_FROM=invitations@selamandkamenju.com
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Port 465: use SMTP_SECURITY=ssl. Unencrypted SMTP is not supported.
